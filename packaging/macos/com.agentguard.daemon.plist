<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentguard.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/agentguard-macos</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/agentguard.log</string>

    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/agentguard.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info,agentguard_core=debug</string>
        <key>HOME</key>
        <string>/Users/Shared</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/var/tmp</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>Nice</key>
    <integer>0</integer>
</dict>
</plist>
